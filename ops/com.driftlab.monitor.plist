<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template (regitel pattern). Install:
       cp ops/com.driftlab.monitor.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.driftlab.monitor.plist
     Adjust the driftlab binary path (`which driftlab`) and WorkingDirectory. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.driftlab.monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/driftlab</string>
    <string>monitor</string>
    <string>run</string>
    <string>--scheduled</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>WorkingDirectory</key><string>/absolute/path/to/driftlab</string>
  <key>StandardOutPath</key><string>/tmp/driftlab-monitor.log</string>
  <key>StandardErrorPath</key><string>/tmp/driftlab-monitor.err</string>
</dict>
</plist>
