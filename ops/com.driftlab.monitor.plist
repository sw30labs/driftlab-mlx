<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.driftlab.monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd /Users/spider/Desktop/driftlabv2 &amp;&amp; .venv/bin/driftlab monitor run --scheduled &gt;&gt; $HOME/.driftlab/monitor.log 2&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/.driftlab/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/.driftlab/launchd.err.log</string>
</dict>
</plist>