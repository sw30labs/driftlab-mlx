      ],
      "remarks": "Certified intended behavior for the loan-officer credit-decisioning agent. High-value and high-risk decisions require human review before funds movement; full-autonomy approvals are budget-capped at 40% of routing decisions."
    },
    "imports": [
      {
        "href": "driftlab-catalog.json",
        "include-controls": [
          { "with-ids": ["dl-1", "dl-2", "dl-3", "dl-4", "dl-5", "dl-6", "dl-7"] }
        ]
      }
    ],
    "modify": {
