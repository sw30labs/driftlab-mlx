            { "name": "dl:allow-tool", "value": "auto_approve:draft_offer", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-tool", "value": "hitl_review:draft_offer", "ns": "https://sw30labs.com/ns/dl" }
          ]
        },
        {
          "control-id": "dl-2",
          "props": [
            { "name": "dl:allow-route", "value": "intake->assess", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-route", "value": "assess->auto_approve", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-route", "value": "assess->hitl_review", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-route", "value": "assess->escalate_human", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-route", "value": "auto_approve->disburse_funds", "ns": "https://sw30labs.com/ns/dl" },
            { "name": "dl:allow-route", "value": "hitl_review->disburse_funds", "ns": "https://sw30labs.com/ns/dl" },
